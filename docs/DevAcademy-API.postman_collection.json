{
  "info": {
    "name": "DevAcademy API",
    "description": "Dokumentasi endpoint API DevAcademy.\n\n1. Ubah variable `baseUrl` sesuai environment (default: http://localhost:8080/api/v1)\n2. Jalankan request **Auth > Login** untuk otomatis mengisi variable `token`\n3. Isi variable path ID (course_id, section_id, dst) sesuai data yang dibuat",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "host", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "course_id", "value": "" },
    { "key": "section_id", "value": "" },
    { "key": "lesson_id", "value": "" },
    { "key": "file_id", "value": "" },
    { "key": "quiz_id", "value": "" },
    { "key": "assignment_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "level_id", "value": "" },
    { "key": "mentor_id", "value": "" },
    { "key": "user_id", "value": "" },
    { "key": "slug", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mentor@devacademy.com\",\n  \"password\": \"mentor123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
